{
  "name": "draft-room-local",
  "version": "0.2.0",
  "private": true,
  "description": "Dependency-free local fantasy football draft assistant",
  "scripts": {
    "start": "node server.js",
    "test": "node --test \"tests/*.test.js\"",
    "package:release": "node scripts/package-release.js --platform portable",
    "package:linux": "node scripts/package-release.js --platform linux-arm64",
    "package:windows": "node scripts/package-release.js --platform windows"
  },
  "engines": {
    "node": ">=20"
  }
}
